# Copy to .env (local) or set in Render Dashboard → Environment

PORT=9001

# Prefer Supabase TRANSACTION pooler (port 6543) on Render to avoid
# "max clients reached in session mode" (session pool ~15).
# Example: jdbc:postgresql://aws-0-….pooler.supabase.com:6543/postgres?sslmode=require&prepareThreshold=0
SPRING_DATASOURCE_URL=jdbc:postgresql://HOST:6543/postgres?sslmode=require&prepareThreshold=0
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=
# Keep small on shared/free Postgres (default in app is 3)
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=3
SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE=0

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

EASYAPPLY_FRONTEND_URL=http://localhost:4200
EASYAPPLY_LINKEDIN_PROVIDER=harvest
EASYAPPLY_APIFY_API_KEY=
EASYAPPLY_HARVEST_API_KEY=
EASYAPPLY_SERPAPI_API_KEY=
EASYAPPLY_RESUME_PATH=
EASYAPPLY_SENDER_NAME=khmoussi aouina

# Required when frontend is on another origin (e.g. localhost → Render)
SESSION_COOKIE_SAME_SITE=none
SESSION_COOKIE_SECURE=true

# Stripe billing (companies + sends quotas)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=

